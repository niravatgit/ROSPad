<?xml version="1.0"?>
<robot name="diffbot_camera">

  <!-- ── Materials ──────────────────────────────────────────────────────────── -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="blue"><color rgba="0.3 0.5 0.9 1"/></material>
  <material name="camera_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="camera_lens"><color rgba="0.1 0.2 0.5 0.8"/></material>

  <!-- ── Base links (same as diffbot_description) ───────────────────────────── -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <geometry><cylinder radius="0.065" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.065" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="right_wheel_link">
    <visual>
      <geometry><cylinder radius="0.065" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.065" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ── Camera link ────────────────────────────────────────────────────────── -->
  <!-- Small box representing the camera body, mounted at the robot's front -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.06 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="camera_black"/>
    </visual>
    <visual>
      <!-- Lens circle -->
      <geometry><cylinder radius="0.012" length="0.005"/></geometry>
      <origin xyz="0.017 0 0" rpy="0 1.5708 0"/>
      <material name="camera_lens"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ── Joints ─────────────────────────────────────────────────────────────── -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_wheel_link"/>
    <origin xyz="0.0 0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_wheel_link"/>
    <origin xyz="0.0 -0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="-0.12 0 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- Camera mounted at the front of the robot, looking forward (+X direction) -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <!-- 15 cm forward, 0 lateral, 16 cm above base_link origin (≈ top of chassis) -->
    <origin xyz="0.15 0 0.16" rpy="0 0 0"/>
  </joint>

  <!-- ── Camera sensor (ROSpad-compatible Gazebo sensor declaration) ─────────── -->
  <!--
    ROSpad's URDF parser detects <gazebo reference="..."><sensor type="camera">
    and creates a Three.js camera rig attached at that link's joint origin.
    The <remapping> sets the topic name published as sensor_msgs/Image.
  -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="front_camera">
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>  <!-- 60° -->
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.01</near><far>10.0</far></clip>
      </camera>
      <plugin name="rospad_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=/camera/image_raw</remapping>
        </ros>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
